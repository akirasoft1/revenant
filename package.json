{
  "name": "revenant",
  "version": "2.21.0",
  "license": "MIT",
  "description": "A Discord bot that talks in your channel's learned voice, with long-term memory, IRC history recall, an agentic code sandbox, and image/video/music generation.",
  "main": "bot.js",
  "scripts": {
    "start": "node bot.js",
    "test": "jest",
    "register:commands": "node scripts/registerCommands.js"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "@elevenlabs/elevenlabs-js": "^2.69.0",
    "@google-cloud/storage": "^8.2.0",
    "@google/genai": "^2.24.0",
    "@grpc/grpc-js": "^1.14.5",
    "@grpc/proto-loader": "^0.8.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@qdrant/js-client-rest": "~1.18.0",
    "@traceloop/instrumentation-openai": "^0.27.0",
    "axios": "^1.20.0",
    "discord-article-archiver-bot": "file:",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.4",
    "google-auth-library": "^11.2.0",
    "mem0ai": "^3.3.1",
    "mongodb": "^7.6.0",
    "onnxruntime-node": "^1.30.0",
    "openai": "^6.49.0",
    "prism-media": "^1.3.5",
    "rss-parser": "^3.13.0",
    "sodium-native": "^5.1.0",
    "tiktoken": "^1.0.22",
    "winston": "^3.19.0"
  },
  "overrides": {
    "tar": "^7.5.22",
    "@google-cloud/storage": {
      "uuid": "^11.1.1"
    },
    "mem0ai": {
      "@google/genai": "$@google/genai"
    }
  },
  "devDependencies": {
    "jest": "^30.5.2"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/hangar-editor/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/hangar-editor/"
    ]
  }
