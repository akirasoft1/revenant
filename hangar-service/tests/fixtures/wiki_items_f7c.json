zes":{"min":2,"max":2},"compatible_types":[{"type":"WeaponGun","sub_types":["Gun"]}],"equipped_item":null,"ports":[]}]},{"uuid":"b837397c-47b6-45e7-b409-db290a068b47","name":"Mantis GT-220 Gatling","class_name":"GATS_BallisticGatling_S3","type":"WeaponGun","sub_type":"Gun","size":3,"grade":"A","class":null,"manufacturer":{"name":"Gallenson Tactical Systems","code":"GATS","uuid":"a834198a-3465-4b02-86a5-887e922ec06d","link":"https://api.star-citizen.wiki/api/manufacturers/GATS"},"description":{"en_EN":"The Mantis GT-220 is a hydraulically-driven Gatling-type rotary cannon designed to deliver smaller rounds at a very high rate of fire. The Mantis is designed to shred armor on very fast targets, sacrificing power for absolute saturation of the target area.","de_DE":"Hersteller: Gallenson Tactical Systems\nTyp (En): Ballistic Gatling\nTyp (De): Ballistische Gatling\n\nGr\u00f6\u00dfe: S3\n\nDie Mantis GT-220 ist eine hydraulisch betriebene Gatling-typische Drehkanone, die kleinere Geschosse mit einer sehr hohen Schussrate abfeuert. Der Mantis ist daf\u00fcr ausgelegt, die Panzerung auf sehr schnellen Zielen zu zerfetzen, wobei er an Leistung verliert, um eine vollst\u00e4ndige Zielabdeckung zu gew\u00e4hrleisten.","zh_CN":"\u5236\u9020\u5546\uff1a\u52a0\u4ed1\u68ee\u6218\u672f\u7cfb\u7edf (Gallenson Tactical Systems)\n\u7269\u54c1\u7c7b\u578b\uff1a\u5b9e\u5f39\u52a0\u7279\u6797\n\u5c3a\u5bf8\uff1a3\n\n\u87b3\u8782 GT-220 \u662f\u4e00\u4e2a\u8bbe\u8ba1\u7528\u4e8e\u4ee5\u8d85\u9ad8\u5c04\u901f\u53d1\u5c04\u5c0f\u578b\u5f39\u836f\u7684\u6db2\u538b\u9a71\u52a8\u52a0\u7279\u6797\u7c7b\u578b\u7684\u8f6c\u8f6e\u706b\u70ae\u3002\u87b3\u8782\u4e3a\u6495\u788e\u8d85\u9ad8\u901f\u76ee\u6807\u7684\u88c5\u7532\u800c\u8bbe\u8ba1\uff0c\u4e3a\u76ee\u6807\u533a\u57df\u7684\u7edd\u5bf9\u9971\u548c\u653b\u51fb\u727a\u7272\u4e86\u5a01\u529b\u3002","fr_FR":"Fabricant: Gallenson Tactical Systems\nType d'article: Mitrailleuse Gatling balistique\nTaille: 3\n\nLe Mantis GT-220 est un canon rotatif de type Gatling \u00e0 entra\u00eenement hydraulique con\u00e7u pour tirer des obus plus petits \u00e0 une cadence de tir tr\u00e8s \u00e9lev\u00e9e. Le Mantis est con\u00e7u pour d\u00e9chiqueter l'armure des cibles tr\u00e8s rapides, sacrifiant la puissance pour une saturation absolue de la zone cible."},"images":[{"source":"starcitizen.tools","original_url":"https://media.starcitizen.tools/c/c1/GATS_GT-220_Mantis.png?0jhqb","thumbnail_url":"https://media.starcitizen.tools/thumb/c/c1/GATS_GT-220_Mantis.png/600px-GATS_GT-220_Mantis.png.webp?0jhqb","original_width":3840,"original_height":2160,"thumbnail_width":600,"thumbnail_height":338}],"uex_prices":{"purchase":[{"price_buy":24045,"price_sell":0,"price_rent":null,"terminal_id":111,"terminal_code":"COUSI","terminal_name":"Cousin Crow's - Providence Platform - Orison","starmap_location":{"name":"Orison","parent_name":"Crusader"},"date_updated":"2026-09-19T18:19:15+00:00","game_version":"4.10.2-LIVE.12881860","uex_link":"https://uexcorp.space/items/info?name=mantis-gt-220-gatling&tab=about"},{"price_buy":28116,"price_sell":0,"price_rent":null,"terminal_id":108,"terminal_code":"CMNEW","terminal_name":"CenterMass - New Babbage","starmap_location":{"name":"New Babbage","parent_name":"microTech"},"date_updated":"2026-09-16T18:16:29+00:00","game_version":"4.10.2-LIVE.12881860","uex_link":"https://uexcorp.space/items/info?name=mantis-gt-220-gatling&tab=about"}]},"vehicle_weapon":{"class":"Gun","type":"Ballistic Gatling","capacity":4314,"range":2398,"damage_per_shot":32,"regeneration":null,"rpm":1600,"damages":[{"type":"impact","name":"physical","damage":32}],"damage":{"sustained_60s":629.1,"burst":853.3,"alpha_total":32,"max":138048,"maximum":138048,"dps":{"physical":853.3,"energy":0,"distortion":0,"thermal":0,"biochemical":0,"stun":0},"alpha":{"physical":32,"energy":0,"distortion":0,"thermal":0,"biochemical":0,"stun":0}},"spread":{"min":0.6,"max":0.6,"minimum":0.6,"maximum":0.6,"first_attack":0.008,"per_attack":0.008